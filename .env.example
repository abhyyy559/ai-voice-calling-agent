# AI Voice Calling Agent - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control — this file contains PLACEHOLDERS ONLY.

# =============================================================================
# AUTH & INTERNAL API (enterprise platform)
# =============================================================================
# JWT signing secret for user auth — MUST be a long random value in production.
JWT_SECRET=n7pchyLEltJ8LpzV8rP1pKqbwwRKzUTNy6QKvd8q/Rx4VToX

# Shared secret the voice-agent worker sends as X-Internal-Token to call
# /internal/* endpoints. Must match between backend and voice-agent.
INTERNAL_API_TOKEN=change_me_internal

# =============================================================================
# TELEPHONY PROVIDERS
# =============================================================================
# Twilio (implemented but DORMANT this phase — no outbound calls are placed).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX  # E.164 format; only used if telephony is enabled

# Exotel (fallback provider for India production) - https://my.exotel.com/
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_token
EXOTEL_NUMBER=+91XXXXXXXXXX  # E.164 format

# Test number (YOUR personal mobile that receives test calls)
TEST_PHONE_NUMBER=your_test_phone_number_e164

# =============================================================================
# VOICE PIPELINE PROVIDERS
# =============================================================================
# Deepgram STT - https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key

# Cartesia TTS - https://cartesia.ai/
CARTESIA_API_KEY=your_cartesia_api_key

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================
# Groq (recommended for fast/cheap) - https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# OpenAI (alternative) - https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# LIVEKIT (Real-time orchestration)
# =============================================================================
# Local dev: run `livekit-server --dev` and keep devkey/devsecret below.
# Production: LiveKit Cloud (Mumbai region) with real project credentials.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# =============================================================================
# DATABASE & CACHE
# =============================================================================
# PostgreSQL (local dev uses docker-compose service 'db')
DATABASE_URL=postgresql://postgres:postgres@db:5432/voice_agent

# Redis (local dev uses docker-compose service 'redis')
REDIS_URL=redis://redis:6379/0

# =============================================================================
# APPLICATION CONFIG
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=info

# Browser origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT access-token lifetime in minutes (default 1 week)
JWT_EXPIRE_MINUTES=10080

# Calling hours enforcement (9 AM - 9 PM local time)
CALLING_HOURS_START=9
CALLING_HOURS_END=21
TIMEZONE=Asia/Kolkata

# Default campaign rate limits (calls per second / max in-flight calls)
DEFAULT_CPS_LIMIT=1
DEFAULT_CONCURRENCY_LIMIT=10

# =============================================================================
# COMPLIANCE (configure per PRD.md §8)
# =============================================================================
# Recording retention period in days (set per institutional policy)
RECORDING_RETENTION_DAYS=90

# DLT registration details (fill after registration)
DLT_ENTITY_ID=your_dlt_entity_id
DLT_TEMPLATE_ID=your_dlt_template_id
