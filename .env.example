# VocalIQ environment template — copy to `.env` and fill in real values.
# NEVER commit the real `.env`.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=info
JWT_SECRET=change_me_long_random_string
INTERNAL_API_TOKEN=change_me_internal_token
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Data stores (compose service names when using Docker) ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/voice_agent
REDIS_URL=redis://redis:6379/0

# --- LiveKit (real-time voice rooms) ---
# Host-facing URL baked into browser tokens:
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_for_local_dev_only
# Container-facing URL used by server-side bridges (media gateway):
LIVEKIT_URL_INTERNAL=ws://livekit:7880

# --- Speech / LLM providers ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Telephony (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_VALIDATE_SIGNATURE=false

# --- Public URLs (tunnel for Twilio webhooks + media stream) ---
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_WS_BASE_URL=

# --- Calling policy ---
TIMEZONE=Asia/Kolkata
CALLING_HOURS_START=9
CALLING_HOURS_END=21
TEST_PHONE_NUMBERS=
CONSENT_ENFORCEMENT=true
DIALER_ENABLED=true
DEFAULT_CPS_LIMIT=1.0
DEFAULT_CONCURRENCY_LIMIT=10
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MINUTES=15

# --- Retention ---
RECORDING_RETENTION_DAYS=90
RETENTION_JOB_ENABLED=true

# --- Domain configs mount (compose sets this literal) ---
DOMAIN_CONFIGS_DIR=/domain-configs
CARTESIA_PRONUNCIATION_DICT_ID=
